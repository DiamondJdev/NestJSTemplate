# Dedicated environment for the E2E suite. Points at the sibling `template_test`
# Postgres database (see docker/init-db.sh) on the docker-compose postgres
# service. Loaded via `node --env-file=.env.test` before Nest bootstraps —
# see the test:e2e script in package.json.
ALLOWED_ORIGINS="http://localhost:5200"
PORT="5200"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/template_test"
DB_SSL="false"
DB_SYNC="true"

JWT_SECRET="e2e-test-only-secret-do-not-use-in-production-0000000000"
JWT_ACCESS_EXP="15m"
JWT_REFRESH_EXP="7d"

TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

NODE_ENV="test"

# CacheService is always overridden with an in-memory fake in tests (see
# test/support/fake-cache.service.ts) — these values are never contacted,
# they only need to be present so CacheService's constructor (getOrThrow)
# doesn't throw before the override is applied.
UPSTASH_REDIS_REST_URL="https://unused-e2e-placeholder.upstash.io"
UPSTASH_REDIS_REST_TOKEN="unused-e2e-placeholder-token"
