# Example environment variables for local development
# ALLOWED_ORIGINS is a comma-separated list of allowed CORS origins.
# Use '*' to allow any origin (not recommended for production).
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5200"
PORT="5200"

# When running via `docker compose up`, the compose file overrides DATABASE_URL
# to point at the bundled `postgres` service. For native `npm run dev`, keep the
# host as `localhost` below.
# PostgreSQL connection string
DATABASE_URL="postgresql://user:pass@localhost/dbname"
DB_SSL="false"
# Set true locally, false in production
DB_SYNC="false"

# Generate a strong secret: openssl rand -base64 64
JWT_SECRET="your-super-secret-key-change-me-in-production"
JWT_ACCESS_EXP="15m"
JWT_REFRESH_EXP="7d"

# Generate a strong key: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your-super-secret-key-change-me-in-production"

NODE_ENV="development"

# Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
